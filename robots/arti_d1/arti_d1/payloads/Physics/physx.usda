#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "arti_d1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "arti_d1"
{
    over "Physics"
    {
        over "left_hip_yaw" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_hip_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_hip_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_knee" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_ankle" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_hip_yaw" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_hip_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_hip_pitch" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_knee" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_ankle" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_arm_m8" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_arm_m8crank_plate" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_arm_m8" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "right_arm_m8crank_plate" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

