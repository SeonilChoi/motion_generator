#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "arti_d1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "arti_d1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "left_hip_yaw" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hip_yaw" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_arm_m8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_arm_m8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "trunk_frame" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_hip_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_knee" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_ankle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hip_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_knee" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ankle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_arm_m8crank_plate" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_arm_m8crank_plate" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "pelvis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_roll_to_pitch" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_thigh" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_shin" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "left_foot_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_foot_2" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "right_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_roll_to_pitch" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_thigh" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_shin" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_foot_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_foot_2" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "left_arm_m8_crank" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_arm_plate" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "right_arm_m8_crank" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_arm_plate" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "trunk" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }
}

